{
  "name": "lowdbg",
  "version": "0.1.0",
  "description": "MCP server that gives AI agents real debugging tools (sanitizers, debuggers, static analysis) for low-level languages. C first, built to extend.",
  "private": true,
  "type": "module",
  "bin": { "lowdbg": "dist/index.js" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}
