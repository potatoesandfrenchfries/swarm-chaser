# Supabase: server-side only. The service-role key bypasses RLS, so it must
# never be given a NEXT_PUBLIC_ prefix.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI: the planner, drafter, verifier and embeddings.
OPENAI_API_KEY=
# RESEARCH_MODEL=gpt-5-mini

# Tavily: web search. Without it the web_search stage is skipped and the run
# uses only the documents you link.
TAVILY_API_KEY=
