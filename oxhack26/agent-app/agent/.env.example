# Model provider keys, loaded by `vite dev` and `flue run`. Any provider Pi
# supports works: https://pi.dev/docs/latest/providers#api-keys
# At least one is required. The registry is in src/lib/models.ts.
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# Optional: turns on the web_search tool. Without it the agents still run and
# the tool is simply not offered.
TAVILY_API_KEY=""
