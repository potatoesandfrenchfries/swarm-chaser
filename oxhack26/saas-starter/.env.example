# Required
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/saas_starter"
NEXTAUTH_URL="http://localhost:3000"
# openssl rand -base64 32
NEXTAUTH_SECRET=""

# Demo sign-in (name + email, no password). Turns itself on when no OAuth
# provider is configured; set to "true" to keep it on alongside OAuth, and
# leave it unset in production.
# ALLOW_DEMO_LOGIN="true"

# Optional: OAuth providers
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional: Stripe. Without these, the unlock button says payments are not set up.
# Webhook for local dev: stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID=""

# Optional: shared rate limiting across serverless instances. Without these,
# limits are kept in memory per process.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
