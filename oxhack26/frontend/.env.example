# Which design to build with: blueprint (white, framed, chamfered) or
# railway (dark, striped, train-line). See DESIGN.md / DESIGN.railway.md.
NEXT_PUBLIC_THEME=blueprint

# Drives the primary call-to-action in the header and landing page.
#   open   -> "REGISTER" -> /register
#   closed -> "SIGN IN"  -> /registration-closed
NEXT_PUBLIC_REGISTRATION=open
