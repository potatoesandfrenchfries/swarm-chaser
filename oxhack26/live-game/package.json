{
  "name": "live-game-template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n web,party -c blue,magenta \"next dev\" \"partykit dev\"",
    "dev:web": "next dev",
    "dev:party": "partykit dev",
    "build": "next build",
    "start": "next start",
    "deploy:party": "partykit deploy",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,css,md}\""
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "next": "^16.0.0",
    "partykit": "^0.0.111",
    "partysocket": "^1.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "postcss": "^8.5.0",
    "prettier": "^3.4.0",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@9.0.0"
}
