# Required: used for every council call.
ANTHROPIC_API_KEY=

# Optional
# COUNCIL_MODEL=claude-opus-5-5          # model for members and the clerk
# COUNCIL_EFFORT=medium                  # low | medium | high | xhigh | max
# COUNCIL_STATE_DIR=.council             # where history and the roster are saved
# COUNCIL_MEMBERS_FILE=./members.json    # replace the default four members (see README)
# COUNCIL_REAP_EVERY=5                   # decisions between reaper runs (0 turns it off)
